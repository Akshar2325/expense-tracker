{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @expense-tracker/database prisma:generate",
    "db:push": "pnpm --filter @expense-tracker/database prisma:push",
    "db:migrate": "pnpm --filter @expense-tracker/database prisma:migrate",
    "db:seed": "pnpm --filter @expense-tracker/database prisma:seed",
    "db:studio": "pnpm --filter @expense-tracker/database prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
